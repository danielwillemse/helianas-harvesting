<form style="overflow-y: scroll;">
  <div class="form-group">
    <div class="form-fields">
      <div class="search-container">
        <div class="filter-tokens">
          {{#each filterTokens}}
            <span class="filter-token" data-token-text="{{this.fullText}}">
              <span class="token-label">{{this.display}}</span>
              <button
                type="button"
                class="token-remove"
                data-action="removeFilterToken"
                data-token-text="{{this.fullText}}"
                aria-label="Remove filter"
              >×</button>
            </span>
          {{/each}}
        </div>
        <input
          type="text"
          class="managed-input debounce form-control"
          id="recipe-search"
          value="{{searchText}}"
          data-binding="searchText"
          placeholder="{{localize "HelianasHarvest.RecipeSearch"}}"
        />
      </div>
    </div>
  </div>
  <table>
    <thead>
      <tr>
        <th scope="col" class="sortable-header" data-sort-column="name" data-action="sortColumn">
          {{localize "HelianasHarvest.ItemNameHeader"}} {{sortIndicators.name}}
        </th>
        <th scope="col" class="sortable-header" data-sort-column="rarity" data-action="sortColumn">
          {{localize "HelianasHarvest.ItemRarity"}} {{sortIndicators.rarity}}
        </th>
        <th scope="col" class="sortable-header" data-sort-column="price" data-action="sortColumn">
          {{localize "HelianasHarvest.ItemPriceHeader"}} {{sortIndicators.price}}
        </th>
        <th scope="col" class="sortable-header" data-sort-column="metatag" data-action="sortColumn">
          {{localize "HelianasHarvest.RecipeMetatag"}} {{sortIndicators.metatag}}
        </th>
        <th scope="col" class="sortable-header" data-sort-column="components" data-action="sortColumn">
          {{localize "HelianasHarvest.RequiredComponents"}} {{sortIndicators.components}}
        </th>
      </tr>
    </thead>
    <tbody>
      {{#each recipes}}
        <tr class="harvest-table-row">
          <td>
            {{#if ../isGM}}
            <a
              class="recipe-item-name display-image-name"
              data-item-name="{{ this.name }}"
              data-item-link="{{ this.link }}"
              data-action="openRecipe"
            >
              <img
                src="{{this.img}}"
                alt="{{this.name}}"
                style="max-height: 2rem;"
              />
              <div>
                {{this.name}}
                {{#if (gt this.qty 1)}} (x{{this.qty}}) {{/if}}
              </div>
            </a>
            {{else}}
            <div class="recipe-item-name display-image-name">
              <img
                src="{{this.img}}"
                alt="{{this.name}}"
                style="max-height: 2rem;"
              />
              <div>
                {{this.name}}
                {{#if (gt this.qty 1)}} (x{{this.qty}}) {{/if}}
              </div>
            </div>
            {{/if}}
          </td>
          <td style="text-align: center;">
            {{ getProperty ../rarityNames this.rarity }}
          </td>
          <td style="text-align: right;">
            {{ this.price }}
          </td>
          <td style="text-align: center;">
            {{ this.metatag }}
          </td>
          <td>
            {{#each this.components}}
              <p class="display-image-name">
                <img src="{{ this.img }}" style="max-height: 1rem"/>
                <span>{{this.name}}</span>
              </p>
            {{/each}}
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</form>
